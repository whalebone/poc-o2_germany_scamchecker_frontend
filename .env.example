# Copy to .env.development.local (git-ignored; only the dev server reads it, vite build does not)
# and the running dev server restarts with real messages going to the backend.

# The page calls VITE_API_URL + /v1/scam-check. /api stays on the page's own origin: the dev server
# passes it on to API_PROXY (vite.config.js), Netlify to the /api redirect in netlify.toml. No CORS needed.
VITE_API_URL=/api
API_PROXY=https://scam-check.dev1.whalebone.io

# For local testing only, never on Netlify: a build puts it into the public JavaScript.
# An integration JWT for the front door (HS256 with its secret; claims client_id, user_id, exp), sent raw.
VITE_API_TOKEN=
